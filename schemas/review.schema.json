{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aimentor.local/schemas/review.schema.json",
  "title": "AI Mentor free-answer review",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "review_id", "attempt_id", "task_id", "score", "feedback",
    "misconceptions", "next_action", "criteria", "needs_human_review"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "review_id": {"$ref": "#/$defs/id"},
    "attempt_id": {"$ref": "#/$defs/id"},
    "task_id": {"$ref": "#/$defs/id"},
    "score": {"type": "integer", "minimum": 0, "maximum": 100},
    "feedback": {"type": "string", "minLength": 1, "maxLength": 10000},
    "misconceptions": {
      "type": "array", "maxItems": 20,
      "items": {"type": "string", "minLength": 1, "maxLength": 1000}
    },
    "next_action": {"type": "string", "minLength": 1, "maxLength": 2000},
    "strong_point": {"type": ["string", "null"], "maxLength": 2000},
    "specific_error": {"type": ["string", "null"], "maxLength": 2000},
    "improved_reasoning": {"type": ["string", "null"], "maxLength": 10000},
    "needs_human_review": {"type": "boolean"},
    "criteria": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["criterion", "points_awarded", "points_possible"],
        "properties": {
          "criterion": {"type": "string", "minLength": 1, "maxLength": 500},
          "points_awarded": {"type": "integer", "minimum": 0, "maximum": 100},
          "points_possible": {"type": "integer", "minimum": 1, "maximum": 100}
        }
      }
    }
  },
  "$defs": {
    "id": {"type": "string", "minLength": 1, "maxLength": 160, "pattern": "^[a-z0-9][a-z0-9._-]*$"}
  }
}
