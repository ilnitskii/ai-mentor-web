{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aimentor.local/schemas/progress-event.schema.json",
  "title": "AI Mentor progress event",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "event_id",
    "user_id",
    "device_id",
    "profile_id",
    "item_id",
    "event_type",
    "occurred_at",
    "timezone",
    "payload"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "event_id": { "$ref": "#/$defs/id" },
    "user_id": { "$ref": "#/$defs/id" },
    "device_id": { "$ref": "#/$defs/id" },
    "profile_id": { "$ref": "#/$defs/id" },
    "item_id": { "$ref": "#/$defs/id" },
    "event_type": {
      "enum": [
        "lesson_completed",
        "card_reviewed",
        "task_submitted",
        "plan_completed",
        "mistake_corrected"
      ]
    },
    "occurred_at": { "type": "string", "format": "date-time" },
    "timezone": { "type": "string", "minLength": 1, "maxLength": 64 },
    "payload": {
      "type": "object",
      "maxProperties": 32,
      "additionalProperties": true
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*$"
    }
  }
}
