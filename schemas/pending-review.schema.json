{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aimentor.local/schemas/pending-review.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "event_id", "attempt_id", "task_id", "submitted_at", "answer", "hints_used"],
  "properties": {
    "schema_version": {"const": 1},
    "event_id": {"$ref": "#/$defs/id"},
    "attempt_id": {"$ref": "#/$defs/id"},
    "task_id": {"$ref": "#/$defs/id"},
    "submitted_at": {"type": "string", "format": "date-time"},
    "answer": {"type": "string", "maxLength": 30000},
    "hints_used": {"type": "integer", "minimum": 0, "maximum": 100},
    "confidence": {"type": ["integer", "null"], "minimum": 0, "maximum": 10}
  },
  "$defs": {
    "id": {"type": "string", "minLength": 1, "maxLength": 160, "pattern": "^[a-z0-9][a-z0-9._-]*$"}
  }
}
